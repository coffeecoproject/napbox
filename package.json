{
  "name": "napbox",
  "version": "0.1.13",
  "private": true,
  "description": "Local dev environments for coding agents on Apple silicon Macs, without Docker: an isolated set of compose services for every git worktree.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "scripts/test-client.sh",
    "plugins": "node scripts/plugins.ts",
    "package": "node scripts/pack.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
